rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images — allow public read so any customer can browse catalog images freely
    // Only the admin account can WRITE (upload/edit) images
    match /products/{imageFile} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "admin@gstore.com";
    }
    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

