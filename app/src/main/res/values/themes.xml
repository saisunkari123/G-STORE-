<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme — no action bar -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!--
        Splash screen theme (applied to MainActivity at startup via AndroidManifest).

        Android 12+ (API 31+) enforces a system splash screen with a mandatory icon
        rendered inside a circular mask. We cannot skip it. Instead, we make it invisible:
        - Background = solid dark green #005A3E
        - Icon = solid dark green 108dp vector (same color → blends into background)
        - Icon background color = same green (circle behind icon → invisible)

        Pre-Android 12: windowBackground = solid green color.

        Result: user sees a plain green screen for ~200ms while the process starts,
        then Compose immediately shows the branded text splash (G-STORE / A SIGN FOR QUALITY).
    -->
    <style name="Theme.MyApplication.Starting" parent="Theme.MyApplication">
        <!-- Android 12+ system splash -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#005A3E</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#005A3E</item>
        <!-- Pre-Android 12 window background -->
        <item name="android:windowBackground">@color/splash_bg_color</item>
        <!-- Transition to base theme after splash dismisses -->
        <item name="postSplashScreenTheme" tools:ignore="PrivateResource">@style/Theme.MyApplication</item>
    </style>
</resources>
