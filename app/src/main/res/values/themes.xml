<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme — no action bar -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Splash screen theme — shown for a split second while the app process boots -->
    <!-- No image/icon here — just the solid dark green color. Compose renders the real text splash. -->
    <style name="Theme.MyApplication.Starting" parent="Theme.MyApplication">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#005A3E</item>
        <item name="android:windowBackground">@color/splash_bg_color</item>
    </style>
</resources>
